{
  "name": "portpilot",
  "displayName": "%ext.displayName%",
  "description": "%ext.description%",
  "version": "1.1.0",
  "publisher": "port-manager-saiki",
  "author": {
    "name": "Cristopher Martinez",
    "email": "cristopher-dev@users.noreply.github.com",
    "url": "https://github.com/cristopher-dev"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#0A0A0F",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cristopher-dev/port-manager"
  },
  "bugs": {
    "url": "https://github.com/cristopher-dev/port-manager/issues"
  },
  "homepage": "https://github.com/cristopher-dev/port-manager#readme",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "port",
    "process",
    "kill",
    "network",
    "tcp",
    "server",
    "debug",
    "devtools",
    "i18n"
  ],
  "activationEvents": [],
  "main": "./src/extension.js",
  "contributes": {
    "configuration": {
      "title": "PortPilot",
      "properties": {
        "portManager.language": {
          "type": "string",
          "enum": [
            "en",
            "es",
            "zh",
            "hi",
            "ar",
            "ja"
          ],
          "default": "",
          "description": "%config.language.description%",
          "enumDescriptions": [
            "English",
            "Español",
            "Chinese",
            "हिन्दी",
            "العربية",
            "日本語"
          ]
        },
        "portManager.witr.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.witr.enabled.description%"
        },
        "portManager.witr.binaryPath": {
          "type": "string",
          "default": "",
          "description": "%config.witr.binaryPath.description%"
        },
        "portManager.mcp.autoconfig": {
          "type": "boolean",
          "default": true,
          "description": "%config.mcp.autoconfig.description%"
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "portpilot.mcp-servers",
        "label": "%mcp.providerLabel%"
      }
    ],
    "commands": [
      {
        "command": "portManager.show",
        "title": "%cmd.show%",
        "icon": "$(list-unordered)"
      },
      {
        "command": "portManager.checkPort",
        "title": "%cmd.checkPort%"
      },
      {
        "command": "portManager.killPort",
        "title": "%cmd.killPort%"
      },
      {
        "command": "portManager.setLanguage",
        "title": "%cmd.setLanguage%"
      },
      {
        "command": "portManager.showAncestry",
        "title": "%cmd.showAncestry%",
        "icon": "$(debug-disconnect)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "portManager",
          "title": "%ext.displayName%",
          "icon": "$(radio-tower)"
        }
      ]
    },
    "views": {
      "portManager": [
        {
          "type": "webview",
          "id": "portManager.panel",
          "name": "%view.title%"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "portManager.show"
        },
        {
          "command": "portManager.checkPort"
        },
        {
          "command": "portManager.killPort"
        },
        {
          "command": "portManager.setLanguage"
        },
        {
          "command": "portManager.showAncestry",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "portManager.show",
        "key": "ctrl+shift+p ctrl+shift+o",
        "mac": "cmd+shift+p cmd+shift+o"
      }
    ]
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^2.22.0"
  },
  "scripts": {
    "lint": "node --check src/extension.js && for f in $(find src -name '*.js' -type f); do node --check \"$f\"; done && for f in $(find mcp-server -name '*.js' -type f); do node --check \"$f\"; done",
    "validate": "node scripts/validate.js",
    "test": "node scripts/smoke-test.js && node scripts/activation-test.js && node scripts/nls-resolution-test.js && node scripts/witr-smoke-test.js && node scripts/witr-functional-test.js && node scripts/containers-locks-test.js && node scripts/mcp-smoke-test.js && node scripts/autoconfig-test.js",
    "postinstall": "node scripts/postinstall.js",
    "manual-install": "node scripts/manual-install-test.js",
    "build": "npm run lint && npm run validate && npm test && vsce package --no-dependencies",
    "package": "vsce package",
    "publish": "vsce publish",
    "mcp": "node mcp-server/index.js"
  },
  "bin": {
    "portpilot-mcp": "mcp-server/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  }
}
