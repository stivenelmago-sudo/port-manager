{
  "name": "port-manager",
  "displayName": "%ext.displayName%",
  "description": "%ext.description%",
  "version": "1.1.0",
  "publisher": "port-manager-saiki",
  "author": {
    "name": "port-manager-saiki"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#0A0A0F",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/saisai-web/port-manager"
  },
  "bugs": {
    "url": "https://github.com/saisai-web/port-manager/issues"
  },
  "homepage": "https://github.com/saisai-web/port-manager#readme",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "port",
    "process",
    "kill",
    "network",
    "tcp",
    "server",
    "debug",
    "devtools",
    "i18n"
  ],
  "activationEvents": [],
  "main": "./src/extension.js",
  "contributes": {
    "configuration": {
      "title": "Port Manager",
      "properties": {
        "portManager.language": {
          "type": "string",
          "enum": [
            "en",
            "es",
            "zh",
            "hi",
            "ar",
            "ja"
          ],
          "default": "",
          "description": "%config.language.description%",
          "enumDescriptions": [
            "English",
            "Español",
            "中文",
            "हिन्दी",
            "العربية",
            "日本語"
          ]
        }
      }
    },
    "commands": [
      {
        "command": "portManager.show",
        "title": "%cmd.show%",
        "icon": "$(list-unordered)"
      },
      {
        "command": "portManager.checkPort",
        "title": "%cmd.checkPort%"
      },
      {
        "command": "portManager.killPort",
        "title": "%cmd.killPort%"
      },
      {
        "command": "portManager.setLanguage",
        "title": "%cmd.setLanguage%"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "portManager",
          "title": "%ext.displayName%",
          "icon": "$(plug)"
        }
      ]
    },
    "views": {
      "portManager": [
        {
          "type": "webview",
          "id": "portManager.panel",
          "name": "%view.title%"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "portManager.show"
        },
        {
          "command": "portManager.checkPort"
        },
        {
          "command": "portManager.killPort"
        },
        {
          "command": "portManager.setLanguage"
        }
      ]
    },
    "keybindings": [
      {
        "command": "portManager.show",
        "key": "ctrl+shift+p ctrl+shift+o",
        "mac": "cmd+shift+p cmd+shift+o"
      }
    ]
  },
  "devDependencies": {
    "@vscode/vsce": "^2.22.0",
    "@types/vscode": "^1.80.0"
  },
  "scripts": {
    "lint": "node --check src/extension.js && for f in $(find src -name '*.js' -type f); do node --check \"$f\"; done",
    "validate": "node scripts/validate.js",
    "test": "node scripts/smoke-test.js",
    "build": "npm run lint && npm run validate && npm test && vsce package --no-dependencies",
    "package": "vsce package",
    "publish": "vsce publish"
  }
}
